<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise API Automation Suite" parallel="methods" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.enterprise.automation.listeners.TestListener"/>
        <listener class-name="com.enterprise.automation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="API Regression and E2E Tests">
        <packages>
            <package name="com.enterprise.automation.tests.users"/>
            <package name="com.enterprise.automation.tests.payments"/>
            <package name="com.enterprise.automation.tests.schema"/>
        </packages>
    </test>

</suite>
